# Neon (pulled via `neon env pull` / Console)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Expo public (safe for client)
EXPO_PUBLIC_NEON_AUTH_URL=
EXPO_PUBLIC_NEON_DATA_API_URL=
# Optional: trusted Origin for Neon Auth on native prod builds (defaults to http://localhost:8081)
# EXPO_PUBLIC_AUTH_ORIGIN=https://your-trusted-origin.example

# Google OAuth — public Client ID only (same Web client ID as Neon Console → Auth → Google).
# Required for Google sign-in on iOS/Android (id_token). Web can use Neon redirect without it.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Optional native clients (recommended for store builds):
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ─── Sign in with Apple (Stack backend — NOT Neon Auth) ─────────────────────
# 1) Secrets in .env.local → npm run eas:push-apple-env
# 2) Deploy API → npm run deploy:api
# 3) Set EXPO_PUBLIC_API_BASE_URL to the Production URL, then re-run step 1
EXPO_PUBLIC_API_BASE_URL=https://nassimelh-stack.expo.app
#
# Server-only (never ship in the IPA as EXPO_PUBLIC_*):
STACK_SESSION_SECRET=
APPLE_BUNDLE_ID=me.nassimelh.stack
# Optional web Services ID audience:
# APPLE_SERVICES_ID=
# APPLE_CLIENT_ID=

# Public site for App Store privacy / terms / support URLs
EXPO_PUBLIC_SITE_URL=https://stack.nassimelh.me
# → Privacy:  https://stack.nassimelh.me/legal/privacy.html
# → Terms:    https://stack.nassimelh.me/legal/terms.html
# → Support:  https://stack.nassimelh.me/legal/support.html
# Also add https://stack.nassimelh.me to Neon Auth → Domains (trusted origin, no path).

# EAS project: https://expo.dev/accounts/nassimelh/projects/stack
EAS_PROJECT_ID=9db897d7-c686-46d6-bd77-7cf6ddf69654

# ─── PostHog (product analytics) ───────────────────────────────────────────
# 1. Create a project at https://app.posthog.com (or EU: https://eu.posthog.com)
# 2. Project settings → Project API key (starts with phc_)
# 3. Paste it below, then restart Expo with a clean cache: npx expo start -c
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
# US: https://us.i.posthog.com  |  EU: https://eu.i.posthog.com
POSTHOG_HOST=https://eu.i.posthog.com
